    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.dedupe_key);\nconst cutoff = Date.now() - 7 * 86400000;\nconst recent = rows.filter(r => { const t = new Date(r.received_at).getTime(); return !isNaN(t) && t >= cutoff; });\nif (!recent.length) return [{ json: { summary: '📊 Weekly invoices: none processed this week.' } }];\nconst by = {};\nfor (const r of recent) {\n  const k = `${r.supplier} (${r.currency})`;\n  by[k] = by[k] || { count: 0, total: 0 };\n  by[k].count += 1;\n  by[k].total += Number(r.total) || 0;\n}\nconst lines = Object.entries(by).sort((a, b) => b[1].total - a[1].total)\n  .map(([k, v]) => `${k}: ${v.count} invoice(s), ${v.total.toFixed(2)}`);\nreturn [{ json: { summary: `📊 Weekly invoices (${recent.length})\\n` + lines.join('\\n') } }];"
      },
